#!/bin/sh

pidfile=/run/veloraime-demo.pid

case "$1" in
  start)
    if [ -r "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
      exit 0
    fi
    . /etc/profile.d/qt6.sh
    if awk '$2 == "/userdata" { found=1 } END { exit !found }' /proc/mounts; then
      export XDG_DATA_HOME=/userdata/veloraime/data
      export XDG_CONFIG_HOME=/userdata/veloraime/config
      umask 077
      mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" || exit 1
    fi
    (
      count=0
      while [ ! -S "$XDG_RUNTIME_DIR/${WAYLAND_DISPLAY:-wayland-0}" ]; do
        [ "$count" -lt 100 ] || exit 1
        count=$((count + 1))
        sleep 0.1
      done
      exec /usr/bin/veloraime-demo
    ) > /var/log/veloraime-demo.log 2>&1 &
    echo "$!" > "$pidfile"
    ;;
  stop)
    if [ -r "$pidfile" ]; then
      kill "$(cat "$pidfile")" 2>/dev/null || true
      rm -f "$pidfile"
    fi
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  *)
    exit 1
    ;;
esac
